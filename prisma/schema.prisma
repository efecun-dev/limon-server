generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  USER
}

model Branch {
  id        String   @id // Trendyol Store ID (örn: "479045")
  name      String   // Şube Adı (örn: "Atakum Gross")
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  name        String
  password    String    // bcrypt hash
  role        Role      @default(USER)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

model Notification {
  id         String   @id @default(cuid())
  type       String   // "order", "return", "review", "cancellation", "system"
  title      String
  message    String
  entityId   String?
  targetUrl  String   @default("/")
  targetUser String?  @default("all") // "all" or specific username
  createdAt  DateTime @default(now())

  userReads  UserNotificationRead[]

  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model UserNotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String       // username or User id (e.g. "admin", "operator")
  readAt         DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("user_notification_reads")
}

model Order {
  id                  String   @id // packageId veya orderId/custom ID
  orderNumber         String   // Trendyol sipariş numarası
  packageNumber       String?  // Paket numarası
  orderDate           DateTime // Sipariş tarihi (tarih filtreleri için)
  orderDateMs         BigInt   // Unix timestamp (ms) - hızlı sıralama için
  storeId             String   // Trendyol Mağaza / Şube ID
  storeName           String?  // Şube adı (örn: "Limon-2 Süpermarket Atakum")
  packageStatus       String   // "Delivered", "Cancelled", "Picking", "Created" vb.
  totalPrice          Float    @default(0) // Müşterinin ödediği nihai tutar
  grossAmount         Float    @default(0) // Brüt tutar
  totalDiscount       Float    @default(0) // İndirim tutarı
  sellerInvoiceAmount Float?   @default(0) // Fatura / Hakediş tutarı
  currencyCode        String   @default("TRY")
  customerName        String?  // Müşteri Adı Soyadı
  customerPhone       String?  // Telefon (varsa)
  customerCity        String?  // Şehir
  customerDistrict    String?  // İlçe
  deliveryModel       String?  // "STORE" vb.
  itemCount           Int      @default(0) // Ürün adedi
  itemsSummary        String?  // Satırlardaki ürünlerin isimleri (hızlı arama için)
  cancelReason        String?  // Varsa iptal nedeni
  source              String   @default("trendyol_api") // "trendyol_api", "webhook", "excel_import"
  rawData             Json?    // Trendyol ham paket JSON verisi (satırlar, barkodlar, fiyatlar, adresler)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([orderDate])
  @@index([orderDateMs])
  @@index([storeId])
  @@index([packageStatus])
  @@index([orderNumber])
  @@index([source])
  @@map("orders")
}
