generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  USER
}

model Branch {
  id        String   @id // Trendyol Store ID (örn: "479045")
  name      String   // Şube Adı (örn: "Atakum Gross")
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  name        String
  password    String    // bcrypt hash
  role        Role      @default(USER)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

model Notification {
  id         String   @id @default(cuid())
  type       String   // "order", "return", "review", "cancellation", "system"
  title      String
  message    String
  entityId   String?
  targetUrl  String   @default("/")
  targetUser String?  @default("all") // "all" or specific username
  createdAt  DateTime @default(now())

  userReads  UserNotificationRead[]

  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model UserNotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String       // username or User id (e.g. "admin", "operator")
  readAt         DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("user_notification_reads")
}

